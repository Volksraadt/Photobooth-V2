{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "PB_LOCAL_DB",
    "PB_DB_POOL_MAX",
    "PB_AUTH_MODE",
    "DEV_AUTH_SECRET",
    "SECRET_MASTER_KEY",
    "GOOGLE_*",
    "REDIS_URL",
    "FFMPEG_PATH",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_JWT_SECRET",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "API_PORT",
    "PB_*",
    "VITE_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test": {
      "outputs": []
    },
    "test:e2e": {
      "cache": false
    }
  }
}
