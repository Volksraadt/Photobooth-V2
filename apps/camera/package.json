{
  "name": "@pb/camera",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tablet camera app: React + Capacitor",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "cap:sync": "vite build && cap sync",
    "cap:android": "vite build && cap sync android && cap open android",
    "cap:ios": "vite build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/camera-preview": "^8.0.2",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@pb/capture": "workspace:*",
    "jsqr": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
